<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- 仅 API 26–28：往公共媒体库写文件需要运行时权限；29+ 走 MediaStore 无需权限 -->
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />

    <!--
      Android 11+ 包可见性：仅当声明 <queries> 时才能 getPackageInfo 到指定包。
      扫码登录一键唤起哔哩哔哩官方 App 需要查询这个包。
    -->
    <queries>
        <package android:name="tv.danmaku.bili" />
    </queries>

    <application
        android:name=".BiliSeekApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.BiliSeek">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboardHidden"
            android:supportsPictureInPicture="true"
            android:theme="@style/Theme.BiliSeek">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- B 站 App 的「分享到」。新用户第一次接触本 App 最可能的路径 -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>

            <!-- 浏览器里点开的 B 站链接 -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="b23.tv" />
                <data android:scheme="http" android:host="b23.tv" />
                <data
                    android:scheme="https"
                    android:host="www.bilibili.com"
                    android:pathPrefix="/video/" />
                <data
                    android:scheme="https"
                    android:host="m.bilibili.com"
                    android:pathPrefix="/video/" />
            </intent-filter>
        </activity>

        <!-- 下载前台服务。与播放服务分开：下载跟着任务队列走，播放跟着用户听 -->
        <service
            android:name=".download.DownloadService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

    </application>

</manifest>
