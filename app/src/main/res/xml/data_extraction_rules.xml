<?xml version="1.0" encoding="utf-8"?>
<!-- API 31+ 的备份 / 设备迁移规则（android:dataExtractionRules）。理由同 backup_rules.xml。 -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="datastore/biliseek_ai_settings.preferences_pb" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="datastore/biliseek_ai_settings.preferences_pb" />
    </device-transfer>
</data-extraction-rules>
