<?xml version="1.0" encoding="utf-8"?>
<!--
  自适应图标前景。path 与 docs/assets/logo.svg 完全一致（1024 坐标系），
  外层 group 缩放到 108dp 画布，并让整个图形的最小外接圆（r≈33.5）落在中央 66dp 安全区内。
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <group
        android:scaleX="0.05937"
        android:scaleY="0.05937"
        android:translateX="20.695"
        android:translateY="21.940">
        <group>
            <!-- 机身边框在镜柄处断开：外框顺时针 + 镜柄周围胶囊逆时针，挖出一个洞 -->
            <clip-path android:pathData="M-200,-200 H1224 V1224 H-200 Z M780.9,741.5 L899.4,883.6 A78,78 0 0 0 1019.2,783.6 L900.7,641.5 A78,78 0 0 0 780.9,741.5 Z" />
            <path
                android:pathData="M201,235 H780 A115,115 0 0 1 895,350 V712 A115,115 0 0 1 780,827 H201 A115,115 0 0 1 86,712 V350 A115,115 0 0 1 201,235 Z"
                android:strokeColor="@color/biliseek_brand_blue"
                android:strokeWidth="62"
                android:strokeLineCap="round"
                android:strokeLineJoin="round" />
        </group>
        <!-- 天线 -->
        <path
            android:pathData="M285,80 L415,212 M685,80 L555,212"
            android:strokeColor="@color/biliseek_brand_blue"
            android:strokeWidth="62"
            android:strokeLineCap="round" />
        <!-- 机脚 -->
        <path
            android:pathData="M242,845 L242,860 M743,845 L743,860"
            android:strokeColor="@color/biliseek_brand_blue"
            android:strokeWidth="75"
            android:strokeLineCap="round" />
        <!-- 眨眼 + 微笑 -->
        <path
            android:pathData="M242,515 L390,462 M360,650 Q465,780 565,668"
            android:strokeColor="@color/biliseek_brand_blue"
            android:strokeWidth="56"
            android:strokeLineCap="round" />
        <!-- 放大镜：镜片 + 镜中弯眼 -->
        <path
            android:pathData="M516,488 A155,155 0 1 1 826,488 A155,155 0 1 1 516,488 Z M590,512 Q672,410 755,512"
            android:strokeColor="@color/biliseek_brand_blue"
            android:strokeWidth="46"
            android:strokeLineCap="round" />
        <!-- 镜颈 -->
        <path
            android:pathData="M773.5,610.9 L831.2,680"
            android:strokeColor="@color/biliseek_brand_blue"
            android:strokeWidth="40"
            android:strokeLineCap="round" />
        <!-- 镜柄 -->
        <path
            android:pathData="M840.8,691.5 L959.3,833.6"
            android:strokeColor="@color/biliseek_brand_blue"
            android:strokeWidth="88"
            android:strokeLineCap="round" />
    </group>
</vector>
